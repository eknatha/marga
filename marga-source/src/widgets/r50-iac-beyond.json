 {
  "id": "ib-state",
  "module": "iac-beyond",
  "lesson": "iac-beyond/state-secrets-and-safe-migrations",
  "title": "Is the migration safe?",
  "summary": "Turn on the steps of a safe state migration.",
  "inputs": [
   {
    "id": "a",
    "label": "State backed up",
    "type": "toggle",
    "value": false
   },
   {
    "id": "b",
    "label": "Locking enabled",
    "type": "toggle",
    "value": false
   },
   {
    "id": "c",
    "label": "moved or import used",
    "type": "toggle",
    "value": false
   },
   {
    "id": "d",
    "label": "Plan shows no changes",
    "type": "toggle",
    "value": false
   }
  ],
  "vars": [
   [
    "done",
    "(a?1:0)+(b?1:0)+(c?1:0)+(d?1:0)"
   ]
  ],
  "nodes": [
   {
    "id": "n0",
    "label": "Backup",
    "x": 0,
    "y": 0,
    "state": "a ? 0 : 2",
    "sub": "a ? 'backed up' : 'at risk'"
   },
   {
    "id": "n1",
    "label": "Lock",
    "x": 1,
    "y": 0,
    "state": "b ? 0 : 2",
    "sub": "b ? 'locked' : 'unlocked'"
   },
   {
    "id": "n2",
    "label": "Method",
    "x": 2,
    "y": 0,
    "state": "c ? 0 : 2",
    "sub": "c ? 'declarative' : 'manual edit'"
   }
  ],
  "edges": [
   {
    "from": "n0",
    "to": "n1",
    "flow": "a?0:1",
    "bad": "!a"
   },
   {
    "from": "n1",
    "to": "n2",
    "flow": "b?0:1",
    "bad": "!b"
   }
  ],
  "readouts": [
   {
    "label": "Practices in place",
    "expr": "done",
    "dp": 0
   },
   {
    "label": "Practices missing",
    "expr": "4-done",
    "dp": 0
   },
   {
    "label": "Total practices",
    "expr": "4",
    "dp": 0
   }
  ],
  "verdicts": [
   {
    "when": "!a",
    "tone": "bad",
    "text": "Changing state without a backup can lose track of real resources."
   },
   {
    "when": "!b || !c || !d",
    "tone": "warn",
    "text": "Backups exist but the method or verification is weak."
   },
   {
    "when": "true",
    "tone": "good",
    "text": "Backup, locking, declarative moves and a clean plan."
   }
  ],
  "tries": [
   "Turn on only \"State backed up\".",
   "Turn on all four.",
   "Turn on everything except \"Plan shows no changes\"."
  ],
  "presets": [
   {
    "id": "break",
    "label": "Break it",
    "story": "Nothing in place.",
    "tone": "bad",
    "values": {
     "a": false,
     "b": false,
     "c": false,
     "d": false
    }
   },
   {
    "id": "fix",
    "label": "Fix it",
    "story": "All practices in place.",
    "tone": "good",
    "values": {
     "a": true,
     "b": true,
     "c": true,
     "d": true
    }
   }
  ]
 }
]

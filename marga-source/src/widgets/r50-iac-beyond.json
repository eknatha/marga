[
 {
  "id": "ib-tool",
  "module": "iac-beyond",
  "lesson": "iac-beyond/opentofu-and-the-terraform-ecosystem-choices",
  "title": "Is the tool choice sound?",
  "summary": "Check what a team should confirm before choosing an IaC tool.",
  "inputs": [
   {
    "id": "a",
    "label": "Licence reviewed",
    "type": "toggle",
    "value": false
   },
   {
    "id": "b",
    "label": "Provider support checked",
    "type": "toggle",
    "value": false
   },
   {
    "id": "c",
    "label": "Team skills considered",
    "type": "toggle",
    "value": false
   },
   {
    "id": "d",
    "label": "Tried on a small project",
    "type": "toggle",
    "value": false
   }
  ],
  "vars": [
   [
    "done",
    "(a?1:0)+(b?1:0)+(c?1:0)+(d?1:0)"
   ]
  ],
  "nodes": [
   {
    "id": "n0",
    "label": "Licence",
    "x": 0,
    "y": 0,
    "state": "a ? 0 : 2",
    "sub": "a ? 'reviewed' : 'unknown'"
   },
   {
    "id": "n1",
    "label": "Providers",
    "x": 1,
    "y": 0,
    "state": "b ? 0 : 2",
    "sub": "b ? 'checked' : 'assumed'"
   },
   {
    "id": "n2",
    "label": "Skills",
    "x": 2,
    "y": 0,
    "state": "c ? 0 : 2",
    "sub": "c ? 'considered' : 'ignored'"
   }
  ],
  "edges": [
   {
    "from": "n0",
    "to": "n1",
    "flow": "a?0:1",
    "bad": "!a"
   },
   {
    "from": "n1",
    "to": "n2",
    "flow": "b?0:1",
    "bad": "!b"
   }
  ],
  "readouts": [
   {
    "label": "Practices in place",
    "expr": "done",
    "dp": 0
   },
   {
    "label": "Practices missing",
    "expr": "4-done",
    "dp": 0
   },
   {
    "label": "Total practices",
    "expr": "4",
    "dp": 0
   }
  ],
  "verdicts": [
   {
    "when": "!a",
    "tone": "bad",
    "text": "The licence and provider support were never checked, so a surprise is likely."
   },
   {
    "when": "!b || !c || !d",
    "tone": "warn",
    "text": "Some checks are done but a risk remains for the migration."
   },
   {
    "when": "true",
    "tone": "good",
    "text": "Licence, providers, skills and a pilot support the choice."
   }
  ],
  "tries": [
   "Turn on only \"Licence reviewed\".",
   "Turn on all four.",
   "Turn on everything except \"Tried on a small project\"."
  ],
  "presets": [
   {
    "id": "break",
    "label": "Break it",
    "story": "Nothing in place.",
    "tone": "bad",
    "values": {
     "a": false,
     "b": false,
     "c": false,
     "d": false
    }
   },
   {
    "id": "fix",
    "label": "Fix it",
    "story": "All practices in place.",
    "tone": "good",
    "values": {
     "a": true,
     "b": true,
     "c": true,
     "d": true
    }
   }
  ]
 },
 {
  "id": "ib-struct",
  "module": "iac-beyond",
  "lesson": "iac-beyond/terragrunt-modules-and-multi-environment-structure",
  "title": "Will the layout scale?",
  "summary": "Toggle the structure choices that keep many environments manageable.",
  "inputs": [
   {
    "id": "a",
    "label": "Shared versioned modules",
    "type": "toggle",
    "value": false
   },
   {
    "id": "b",
    "label": "Inputs per environment",
    "type": "toggle",
    "value": false
   },
   {
    "id": "c",
    "label": "State per environment",
    "type": "toggle",
    "value": false
   },
   {
    "id": "d",
    "label": "Pinned module versions",
    "type": "toggle",
    "value": false
   }
  ],
  "vars": [
   [
    "done",
    "(a?1:0)+(b?1:0)+(c?1:0)+(d?1:0)"
   ]
  ],
  "nodes": [
   {
    "id": "n0",
    "label": "Modules",
    "x": 0,
    "y": 0,
    "state": "a ? 0 : 2",
    "sub": "a ? 'shared' : 'copied'"
   },
   {
    "id": "n1",
    "label": "Inputs",
    "x": 1,
    "y": 0,
    "state": "b ? 0 : 2",
    "sub": "b ? 'thin' : 'forked'"
   },
   {
    "id": "n2",
    "label": "State",
    "x": 2,
    "y": 0,
    "state": "c ? 0 : 2",
    "sub": "c ? 'split' : 'one file'"
   }
  ],
  "edges": [
   {
    "from": "n0",
    "to": "n1",
    "flow": "a?0:1",
    "bad": "!a"
   },
   {
    "from": "n1",
    "to": "n2",
    "flow": "b?0:1",
    "bad": "!b"
   }
  ],
  "readouts": [
   {
    "label": "Practices in place",
    "expr": "done",
    "dp": 0
   },
   {
    "label": "Practices missing",
    "expr": "4-done",
    "dp": 0
   },
   {
    "label": "Total practices",
    "expr": "4",
    "dp": 0
   }
  ],
  "verdicts": [
   {
    "when": "!a",
    "tone": "bad",
    "text": "Copy pasted environments drift apart and every fix must be repeated."
   },
   {
    "when": "!b || !c || !d",
    "tone": "warn",
    "text": "The structure is shared but state or versions can still cause trouble."
   },
   {
    "when": "true",
    "tone": "good",
    "text": "Modules, inputs, state and versions are separated cleanly."
   }
  ],
  "tries": [
   "Turn on only \"Shared versioned modules\".",
   "Turn on all four.",
   "Turn on everything except \"Pinned module versions\"."
  ],
  "presets": [
   {
    "id": "break",
    "label": "Break it",
    "story": "Nothing in place.",
    "tone": "bad",
    "values": {
     "a": false,
     "b": false,
     "c": false,
     "d": false
    }
   },
   {
    "id": "fix",
    "label": "Fix it",
    "story": "All practices in place.",
    "tone": "good",
    "values": {
     "a": true,
     "b": true,
     "c": true,
     "d": true
    }
   }
  ]
 },
 {

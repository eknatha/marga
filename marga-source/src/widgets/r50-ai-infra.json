    "x": 2,
    "y": 0,
    "state": "c ? 0 : 2",
    "sub": "c ? 'alerting' : 'silent'"
   }
  ],
  "edges": [
   {
    "from": "n0",
    "to": "n1",
    "flow": "a?0:1",
    "bad": "!a"
   },
   {
    "from": "n1",
    "to": "n2",
    "flow": "b?0:1",

[
 {
  "id": "ai-gpu",
  "module": "ai-infra",
  "lesson": "ai-infra/gpu-scheduling-and-sharing-on-kubernetes",
  "title": "Are your GPUs used well?",
  "summary": "Toggle the practices that stop GPU waste.",
  "inputs": [
   {
    "id": "a",
    "label": "Utilisation measured",
    "type": "toggle",
    "value": false
   },
   {
    "id": "b",
    "label": "Sharing method chosen",
    "type": "toggle",
    "value": false
   },
   {
    "id": "c",
    "label": "Right sized requests",
    "type": "toggle",
    "value": false
   },
   {
    "id": "d",
    "label": "Idle GPUs released",
    "type": "toggle",
    "value": false
   }
  ],
  "vars": [
   [
    "done",
    "(a?1:0)+(b?1:0)+(c?1:0)+(d?1:0)"
   ]
  ],
  "nodes": [
   {
    "id": "n0",
    "label": "Metrics",
    "x": 0,
    "y": 0,
    "state": "a ? 0 : 2",
    "sub": "a ? 'measured' : 'unknown'"
   },
   {
    "id": "n1",
    "label": "Sharing",
    "x": 1,
    "y": 0,
    "state": "b ? 0 : 2",
    "sub": "b ? 'MIG or slicing' : 'whole GPUs'"
   },
   {
    "id": "n2",
    "label": "Requests",
    "x": 2,
    "y": 0,
    "state": "c ? 0 : 2",
    "sub": "c ? 'right sized' : 'oversized'"
   }
  ],
  "edges": [
   {
    "from": "n0",
    "to": "n1",
    "flow": "a?0:1",
    "bad": "!a"
   },
   {
    "from": "n1",
    "to": "n2",
    "flow": "b?0:1",
    "bad": "!b"
   }
  ],
  "readouts": [
   {
    "label": "Practices in place",
    "expr": "done",
    "dp": 0
   },
   {
    "label": "Practices missing",
    "expr": "4-done",
    "dp": 0
   },
   {
    "label": "Total practices",
    "expr": "4",
    "dp": 0
   }
  ],
  "verdicts": [
   {
    "when": "!a",
    "tone": "bad",
    "text": "Nobody measures GPU use, so waste is invisible."
   },
   {
    "when": "!b || !c || !d",
    "tone": "warn",
    "text": "Use is measured but sharing or release still wastes capacity."
   },
   {
    "when": "true",
    "tone": "good",
    "text": "Measured, shared and released: GPUs earn their cost."
   }
  ],
  "tries": [
   "Turn on only \"Utilisation measured\".",
   "Turn on all four.",
   "Turn on everything except \"Idle GPUs released\"."
  ],
  "presets": [
   {
    "id": "break",
    "label": "Break it",
    "story": "Nothing in place.",
    "tone": "bad",
    "values": {
     "a": false,
     "b": false,
     "c": false,
     "d": false
    }
   },
   {
    "id": "fix",
    "label": "Fix it",
    "story": "All practices in place.",
    "tone": "good",
    "values": {
     "a": true,
     "b": true,
     "c": true,
     "d": true
    }
   }
  ]
 },
 {
  "id": "ai-vec",
  "module": "ai-infra",
  "lesson": "ai-infra/vector-databases-and-retrieval-operations",
  "title": "Is retrieval healthy?",

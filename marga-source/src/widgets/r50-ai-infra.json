    "label": "Total practices",
    "expr": "4",
    "dp": 0
   }
  ],
  "verdicts": [
   {
    "when": "!a",
    "tone": "bad",
    "text": "A sequential scan makes every query slow as data grows."
   },
   {
    "when": "!b || !c || !d",
    "tone": "warn",
    "text": "Search is fast but freshness or recall might hurt answers."
   },
   {
    "when": "true",
    "tone": "good",
    "text": "Index, filters, freshness and recall are covered."
   }
  ],
  "tries": [
   "Turn on only \"ANN index tuned\".",
   "Turn on all four.",
   "Turn on everything except \"Recall tested\"."
  ],
  "presets": [
   {
    "id": "break",
    "label": "Break it",
    "story": "Nothing in place.",
    "tone": "bad",
    "values": {
     "a": false,
     "b": false,
     "c": false,
     "d": false
    }
   },
   {
    "id": "fix",
    "label": "Fix it",
    "story": "All practices in place.",
    "tone": "good",
    "values": {
     "a": true,
     "b": true,
     "c": true,
     "d": true
    }
   }
  ]
 },
 {

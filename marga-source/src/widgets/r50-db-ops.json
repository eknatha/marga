[
 {
  "id": "db-ha",
  "module": "db-ops",
  "lesson": "db-ops/postgresql-replication-and-high-availability",
  "title": "Is the failover safe?",
  "summary": "Toggle the controls against data loss and split brain.",
  "inputs": [
   {
    "id": "a",
    "label": "Consensus store for leader",
    "type": "toggle",
    "value": false
   },
   {
    "id": "b",
    "label": "Fencing or watchdog",
    "type": "toggle",
    "value": false
   },
   {
    "id": "c",
    "label": "Lag alerts",
    "type": "toggle",
    "value": false
   },
   {
    "id": "d",
    "label": "Slot size alerts",
    "type": "toggle",
    "value": false
   }
  ],
  "vars": [
   [
    "done",
    "(a?1:0)+(b?1:0)+(c?1:0)+(d?1:0)"
   ]
  ],
  "nodes": [
   {
    "id": "n0",
    "label": "Leader",
    "x": 0,
    "y": 0,
    "state": "a ? 0 : 2",
    "sub": "a ? 'consensus' : 'none'"
   },
   {
    "id": "n1",
    "label": "Fence",
    "x": 1,
    "y": 0,
    "state": "b ? 0 : 2",
    "sub": "b ? 'fenced' : 'none'"
   },
   {
    "id": "n2",
    "label": "Lag",
    "x": 2,
    "y": 0,
    "state": "c ? 0 : 2",
    "sub": "c ? 'alerting' : 'silent'"
   }
  ],
  "edges": [
   {
    "from": "n0",
    "to": "n1",
    "flow": "a?0:1",
    "bad": "!a"
   },
   {
    "from": "n1",
    "to": "n2",
    "flow": "b?0:1",
    "bad": "!b"
   }
  ],
  "readouts": [
   {
    "label": "Practices in place",
    "expr": "done",
    "dp": 0
   },
   {
    "label": "Practices missing",
    "expr": "4-done",
    "dp": 0
   },
   {
    "label": "Total practices",
    "expr": "4",
    "dp": 0
   }
  ],
  "verdicts": [
   {
    "when": "!a",
    "tone": "bad",
    "text": "Without a leader election, two nodes may accept writes."
   },
   {
    "when": "!b || !c || !d",
    "tone": "warn",
    "text": "Election exists but fencing or alerts leave gaps."
   },
   {
    "when": "true",
    "tone": "good",
    "text": "Leader election, fencing and alerts protect the data."
   }
  ],
  "tries": [
   "Turn on only \"Consensus store for leader\".",
   "Turn on all four.",
   "Turn on everything except \"Slot size alerts\"."
  ],
  "presets": [
   {
    "id": "break",
    "label": "Break it",
    "story": "Nothing in place.",
    "tone": "bad",
    "values": {
     "a": false,
     "b": false,
     "c": false,
     "d": false
    }
   },
   {
    "id": "fix",
    "label": "Fix it",
    "story": "All practices in place.",
    "tone": "good",
    "values": {
     "a": true,
     "b": true,
     "c": true,
     "d": true
    }
   }
  ]
 },
 {

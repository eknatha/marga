    "id": "break",
    "label": "Break it",
    "story": "Nothing in place.",
    "tone": "bad",
    "values": {
     "a": false,
     "b": false,
     "c": false,
     "d": false
    }
   },
   {
    "id": "fix",
    "label": "Fix it",
    "story": "All practices in place.",
    "tone": "good",
    "values": {
     "a": true,
     "b": true,
     "c": true,
     "d": true
    }
   }
  ]
 },
 {
  "id": "db-pool",
  "module": "db-ops",
  "lesson": "db-ops/connection-pooling-and-capacity",
  "title": "Is connection use healthy?",
  "summary": "Toggle the settings that keep a database away from the connection wall.",
  "inputs": [
   {
    "id": "a",
    "label": "Pooler in transaction mode",
    "type": "toggle",
    "value": false
   },
   {
    "id": "b",
    "label": "Pool sized to CPU",
    "type": "toggle",
    "value": false
   },
   {
    "id": "c",
    "label": "Idle timeouts set",
    "type": "toggle",
    "value": false
   },
   {
    "id": "d",
    "label": "Waiting client alert",
    "type": "toggle",
    "value": false
   }
  ],
  "vars": [
   [
    "done",
    "(a?1:0)+(b?1:0)+(c?1:0)+(d?1:0)"
   ]
  ],
  "nodes": [
   {
    "id": "n0",
    "label": "Pooler",
    "x": 0,
    "y": 0,
    "state": "a ? 0 : 2",
    "sub": "a ? 'pooled' : 'per pod'"
   },
   {
    "id": "n1",
    "label": "Size",
    "x": 1,
    "y": 0,
    "state": "b ? 0 : 2",
    "sub": "b ? 'sized' : 'huge'"
   },
   {
    "id": "n2",
    "label": "Timeouts",
    "x": 2,
    "y": 0,
    "state": "c ? 0 : 2",
    "sub": "c ? 'set' : 'none'"
   }
  ],
  "edges": [
   {
    "from": "n0",
    "to": "n1",
    "flow": "a?0:1",
    "bad": "!a"
   },
   {
    "from": "n1",
    "to": "n2",
    "flow": "b?0:1",
    "bad": "!b"
   }
  ],
  "readouts": [
   {
    "label": "Practices in place",
    "expr": "done",
    "dp": 0
   },
   {
    "label": "Practices missing",
    "expr": "4-done",
    "dp": 0
   },
   {
    "label": "Total practices",
    "expr": "4",
    "dp": 0
   }
  ],
  "verdicts": [
   {
    "when": "!a",
    "tone": "bad",
    "text": "Every pod opens its own connections, so scale out hits the limit."
   },
   {
    "when": "!b || !c || !d",
    "tone": "warn",
    "text": "Pooling exists but sizing or alerts are missing."
   },
   {
    "when": "true",
    "tone": "good",
    "text": "Pooling, sizing, timeouts and alerts keep connections healthy."
   }
  ],
  "tries": [
   "Turn on only \"Pooler in transaction mode\".",
   "Turn on all four.",
   "Turn on everything except \"Waiting client alert\"."
  ],
  "presets": [

    "id": "break",
    "label": "Break it",
    "story": "Nothing in place.",
    "tone": "bad",
    "values": {
     "a": false,
     "b": false,
     "c": false,
     "d": false
    }
   },
   {
    "id": "fix",
    "label": "Fix it",
    "story": "All practices in place.",
    "tone": "good",
    "values": {
     "a": true,
     "b": true,
     "c": true,
     "d": true
    }
   }
  ]
 },
 {
  "id": "db-mig",
  "module": "db-ops",
  "lesson": "db-ops/zero-downtime-migrations-and-upgrades",
  "title": "Is the migration safe?",
  "summary": "Check the steps of a zero downtime schema change.",
  "inputs": [
   {
    "id": "a",
    "label": "Expand and contract",
    "type": "toggle",
    "value": false
   },
   {
    "id": "b",
    "label": "Lock timeout set",
    "type": "toggle",
    "value": false
   },
   {
    "id": "c",
    "label": "Concurrent index builds",
    "type": "toggle",
    "value": false
   },
   {
    "id": "d",
    "label": "Rollback written",
    "type": "toggle",
    "value": false
   }
  ],
  "vars": [
   [
    "done",
    "(a?1:0)+(b?1:0)+(c?1:0)+(d?1:0)"
   ]
  ],
  "nodes": [
   {
    "id": "n0",
    "label": "Plan",
    "x": 0,
    "y": 0,
    "state": "a ? 0 : 2",
    "sub": "a ? 'compatible' : 'breaking'"
   },
   {
    "id": "n1",
    "label": "Lock",
    "x": 1,
    "y": 0,
    "state": "b ? 0 : 2",
    "sub": "b ? 'set' : 'none'"
   },
   {
    "id": "n2",
    "label": "Index",
    "x": 2,
    "y": 0,
    "state": "c ? 0 : 2",
    "sub": "c ? 'concurrent' : 'blocking'"
   }
  ],
  "edges": [
   {
    "from": "n0",
    "to": "n1",
    "flow": "a?0:1",
    "bad": "!a"
   },
   {
    "from": "n1",
    "to": "n2",
    "flow": "b?0:1",
    "bad": "!b"
   }
  ],
  "readouts": [
   {
    "label": "Practices in place",
    "expr": "done",
    "dp": 0
   },
   {
    "label": "Practices missing",
    "expr": "4-done",
    "dp": 0
   },
   {
    "label": "Total practices",
    "expr": "4",
    "dp": 0
   }
  ],
  "verdicts": [
   {
    "when": "!a",
    "tone": "bad",

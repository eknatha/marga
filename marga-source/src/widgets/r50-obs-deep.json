[
 {
  "id": "od-rate",
  "module": "obs-deep",
  "lesson": "obs-deep/promql-in-depth-rates-aggregation-and-recording-rules",
  "title": "Are your rate queries correct?",
  "summary": "Check the habits that keep PromQL results honest.",
  "inputs": [
   {
    "id": "a",
    "label": "Rate used only on counters",
    "type": "toggle",
    "value": false
   },
   {
    "id": "b",
    "label": "Range covers four scrapes",
    "type": "toggle",
    "value": false
   },
   {
    "id": "c",
    "label": "Aggregate after rate",
    "type": "toggle",
    "value": false
   },
   {
    "id": "d",
    "label": "Heavy queries recorded",
    "type": "toggle",
    "value": false
   }
  ],
  "vars": [
   [
    "done",
    "(a?1:0)+(b?1:0)+(c?1:0)+(d?1:0)"
   ]
  ],
  "nodes": [
   {
    "id": "n0",
    "label": "Counters",
    "x": 0,
    "y": 0,
    "state": "a ? 0 : 2",
    "sub": "a ? 'counters' : 'wrong type'"
   },
   {
    "id": "n1",
    "label": "Range",
    "x": 1,
    "y": 0,
    "state": "b ? 0 : 2",
    "sub": "b ? 'wide enough' : 'too short'"
   },
   {
    "id": "n2",
    "label": "Order",
    "x": 2,
    "y": 0,
    "state": "c ? 0 : 2",
    "sub": "c ? 'after' : 'before'"
   }
  ],
  "edges": [
   {
    "from": "n0",
    "to": "n1",
    "flow": "a?0:1",
    "bad": "!a"
   },
   {
    "from": "n1",
    "to": "n2",
    "flow": "b?0:1",
    "bad": "!b"
   }
  ],
  "readouts": [
   {
    "label": "Practices in place",
    "expr": "done",
    "dp": 0
   },
   {
    "label": "Practices missing",
    "expr": "4-done",
    "dp": 0
   },
   {
    "label": "Total practices",
    "expr": "4",
    "dp": 0
   }
  ],
  "verdicts": [
   {
    "when": "!a",
    "tone": "bad",
    "text": "Rate on a gauge or a counter reset can show wrong values and hide an outage."
   },
   {
    "when": "!b || !c || !d",
    "tone": "warn",
    "text": "The core is right but some habits will cause slow or noisy dashboards."
   },
   {
    "when": "true",
    "tone": "good",
    "text": "Queries are correct, aggregated in the right order and cheap to run."
   }
  ],
  "tries": [
   "Turn on only \"Rate used only on counters\".",
   "Turn on all four.",
   "Turn on everything except \"Heavy queries recorded\"."
  ],
  "presets": [
   {
    "id": "break",
    "label": "Break it",
    "story": "Nothing in place.",
    "tone": "bad",
    "values": {
     "a": false,
     "b": false,
     "c": false,
     "d": false
    }
   },
   {
    "id": "fix",
    "label": "Fix it",
    "story": "All practices in place.",
    "tone": "good",
    "values": {
     "a": true,
     "b": true,
     "c": true,
     "d": true
    }
   }
  ]
 },
 {

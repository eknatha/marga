[
 {
  "id": "ld-star",
  "module": "leadership",
  "lesson": "leadership/star-stories-and-behavioral-interviews",
  "title": "Is the story interview ready?",
  "summary": "Check the parts of a strong behavioral story.",
  "inputs": [
   {
    "id": "a",
    "label": "Clear situation",
    "type": "toggle",
    "value": false
   },
   {
    "id": "b",
    "label": "My own actions",
    "type": "toggle",
    "value": false
   },
   {
    "id": "c",
    "label": "Measured result",
    "type": "toggle",
    "value": false
   },
   {
    "id": "d",
    "label": "Lesson learned",
    "type": "toggle",
    "value": false
   }
  ],
  "vars": [
   [
    "done",
    "(a?1:0)+(b?1:0)+(c?1:0)+(d?1:0)"
   ]
  ],
  "nodes": [
   {
    "id": "n0",
    "label": "Situation",
    "x": 0,
    "y": 0,
    "state": "a ? 0 : 2",
    "sub": "a ? 'clear' : 'vague'"
   },
   {
    "id": "n1",
    "label": "Action",
    "x": 1,
    "y": 0,
    "state": "b ? 0 : 2",
    "sub": "b ? 'I did' : 'we did'"
   },
   {
    "id": "n2",
    "label": "Result",
    "x": 2,
    "y": 0,
    "state": "c ? 0 : 2",
    "sub": "c ? 'measured' : 'none'"
   }
  ],
  "edges": [
   {
    "from": "n0",
    "to": "n1",
    "flow": "a?0:1",
    "bad": "!a"
   },
   {
    "from": "n1",
    "to": "n2",
    "flow": "b?0:1",
    "bad": "!b"
   }
  ],
  "readouts": [
   {
    "label": "Practices in place",
    "expr": "done",
    "dp": 0
   },
   {
    "label": "Practices missing",
    "expr": "4-done",
    "dp": 0
   },
   {
    "label": "Total practices",
    "expr": "4",
    "dp": 0
   }
  ],
  "verdicts": [
   {
    "when": "!a",
    "tone": "bad",
    "text": "The story has no clear setting, so the listener cannot follow it."
   },
   {
    "when": "!b || !c || !d",
    "tone": "warn",
    "text": "The story starts well but is missing action detail or impact."
   },
   {
    "when": "true",
    "tone": "good",
    "text": "Situation, actions, result and lesson are all present."
   }
  ],
  "tries": [
   "Turn on only \"Clear situation\".",
   "Turn on all four.",
   "Turn on everything except \"Lesson learned\"."
  ],
  "presets": [
   {
    "id": "break",
    "label": "Break it",
    "story": "Nothing in place.",
    "tone": "bad",
    "values": {
     "a": false,
     "b": false,
     "c": false,
     "d": false
    }
   },
   {
    "id": "fix",
    "label": "Fix it",
    "story": "All practices in place.",
    "tone": "good",
    "values": {
     "a": true,
     "b": true,
     "c": true,
     "d": true
    }
   }
  ]
 },
 {

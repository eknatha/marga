    "state": "b ? 0 : 2",
    "sub": "b ? 'shown' : 'hidden'"
   },
   {
    "id": "n2",
    "label": "Decision",
    "x": 2,
    "y": 0,
    "state": "c ? 0 : 2",
    "sub": "c ? 'recorded' : 'lost'"
   }
  ],
  "edges": [
   {
    "from": "n0",
    "to": "n1",
    "flow": "a?0:1",
    "bad": "!a"

[
 {
  "id": "py-pack",
  "module": "python-ops",
  "lesson": "python-ops/project-structure-packaging-and-virtual-environments",
  "title": "Is the tool packaged well?",
  "summary": "Toggle the packaging basics that make a script installable anywhere.",
  "inputs": [
   {
    "id": "a",
    "label": "pyproject.toml and src layout",
    "type": "toggle",
    "value": false
   },
   {
    "id": "b",
    "label": "Virtual environment",
    "type": "toggle",
    "value": false
   },
   {
    "id": "c",
    "label": "Locked dependencies",
    "type": "toggle",
    "value": false
   },
   {
    "id": "d",
    "label": "Entry point command",
    "type": "toggle",
    "value": false
   }
  ],
  "vars": [
   [
    "done",
    "(a?1:0)+(b?1:0)+(c?1:0)+(d?1:0)"
   ]
  ],
  "nodes": [
   {
    "id": "n0",
    "label": "Layout",
    "x": 0,
    "y": 0,
    "state": "a ? 0 : 2",
    "sub": "a ? 'packaged' : 'script'"
   },
   {
    "id": "n1",
    "label": "Env",
    "x": 1,
    "y": 0,
    "state": "b ? 0 : 2",
    "sub": "b ? 'isolated' : 'system'"
   },
   {
    "id": "n2",
    "label": "Lock",
    "x": 2,
    "y": 0,
    "state": "c ? 0 : 2",
    "sub": "c ? 'locked' : 'floating'"
   }
  ],
  "edges": [
   {
    "from": "n0",
    "to": "n1",
    "flow": "a?0:1",
    "bad": "!a"
   },
   {
    "from": "n1",
    "to": "n2",
    "flow": "b?0:1",
    "bad": "!b"
   }
  ],
  "readouts": [
   {
    "label": "Practices in place",
    "expr": "done",
    "dp": 0
   },
   {
    "label": "Practices missing",
    "expr": "4-done",
    "dp": 0
   },
   {
    "label": "Total practices",
    "expr": "4",
    "dp": 0
   }
  ],
  "verdicts": [
   {
    "when": "!a",
    "tone": "bad",
    "text": "A loose script depends on whatever is on the machine."
   },
   {
    "when": "!b || !c || !d",
    "tone": "warn",
    "text": "Packaging is started but dependencies or entry points are loose."
   },
   {
    "when": "true",
    "tone": "good",
    "text": "Layout, environment, lock file and command are reproducible."
   }
  ],
  "tries": [
   "Turn on only \"pyproject.toml and src layout\".",
   "Turn on all four.",
   "Turn on everything except \"Entry point command\"."
  ],
  "presets": [
   {
    "id": "break",
    "label": "Break it",
    "story": "Nothing in place.",
    "tone": "bad",
    "values": {
     "a": false,
     "b": false,
     "c": false,
     "d": false
    }
   },
   {
    "id": "fix",
    "label": "Fix it",
    "story": "All practices in place.",
    "tone": "good",
    "values": {
     "a": true,
     "b": true,
     "c": true,
     "d": true
    }
   }
  ]
 },

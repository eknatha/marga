[
 {
  "id": "ru-own",
  "module": "rust-infra",
  "lesson": "rust-infra/why-rust-ownership-borrowing-and-the-mental-model",
  "title": "Will this compile?",
  "summary": "Toggle the habits that satisfy the borrow checker.",
  "inputs": [
   {
    "id": "a",
    "label": "Borrow instead of moving",
    "type": "toggle",
    "value": false
   },
   {
    "id": "b",
    "label": "One mutable reference at a time",
    "type": "toggle",
    "value": false
   },
   {
    "id": "c",
    "label": "References do not outlive data",
    "type": "toggle",
    "value": false
   },
   {
    "id": "d",
    "label": "Clone only on purpose",
    "type": "toggle",
    "value": false
   }
  ],
  "vars": [
   [
    "done",
    "(a?1:0)+(b?1:0)+(c?1:0)+(d?1:0)"
   ]
  ],
  "nodes": [
   {
    "id": "n0",
    "label": "Borrow",
    "x": 0,
    "y": 0,
    "state": "a ? 0 : 2",
    "sub": "a ? 'borrowed' : 'moved'"
   },
   {
    "id": "n1",
    "label": "Mutability",
    "x": 1,
    "y": 0,
    "state": "b ? 0 : 2",
    "sub": "b ? 'exclusive' : 'shared mutable'"
   },
   {
    "id": "n2",
    "label": "Lifetime",
    "x": 2,
    "y": 0,
    "state": "c ? 0 : 2",
    "sub": "c ? 'valid' : 'dangling'"
   }
  ],
  "edges": [
   {
    "from": "n0",
    "to": "n1",
    "flow": "a?0:1",
    "bad": "!a"
   },
   {
    "from": "n1",
    "to": "n2",
    "flow": "b?0:1",
    "bad": "!b"
   }
  ],
  "readouts": [
   {
    "label": "Practices in place",
    "expr": "done",
    "dp": 0
   },
   {
    "label": "Practices missing",
    "expr": "4-done",
    "dp": 0
   },
   {
    "label": "Total practices",
    "expr": "4",
    "dp": 0
   }
  ],
  "verdicts": [
   {
    "when": "!a",
    "tone": "bad",
    "text": "Use after move or aliasing breaks the rules and the compiler refuses."
   },
   {
    "when": "!b || !c || !d",
    "tone": "warn",
    "text": "The core rules hold but some choices will cost performance or clarity."
   },
   {
    "when": "true",
    "tone": "good",
    "text": "Borrowing, exclusivity and lifetimes are respected."
   }
  ],
  "tries": [
   "Turn on only \"Borrow instead of moving\".",
   "Turn on all four.",
   "Turn on everything except \"Clone only on purpose\"."
  ],
  "presets": [
   {
    "id": "break",
    "label": "Break it",
    "story": "Nothing in place.",
    "tone": "bad",
    "values": {
     "a": false,
     "b": false,
     "c": false,
     "d": false
    }
   },
   {
    "id": "fix",
    "label": "Fix it",
    "story": "All practices in place.",
    "tone": "good",
    "values": {
     "a": true,
     "b": true,
     "c": true,
     "d": true
    }
   }
  ]
 },

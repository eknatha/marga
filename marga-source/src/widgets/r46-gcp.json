[
 {
  "id": "gcp-budget-runway",
  "module": "gcp",
  "lesson": "gcp/google-cloud-organization-projects-and-billing",
  "title": "Budget runway",
  "summary": "Spend so far, daily growth and the monthly budget show when alerts fire and when the budget runs out.",
  "inputs": [
   {
    "id": "budget",
    "label": "Monthly budget",
    "min": 100,
    "max": 100000,
    "value": 5000,
    "step": 100,
    "unit": "USD"
   },
   {
    "id": "spent",
    "label": "Spent so far",
    "min": 0,
    "max": 100000,
    "value": 1500,
    "step": 50,
    "unit": "USD"
   },
   {
    "id": "day",
    "label": "Day of the month",
    "min": 1,
    "max": 30,
    "value": 10,
    "step": 1
   },
   {
    "id": "growth",
    "label": "Daily spend rises by",
    "min": 0,
    "max": 20,
    "value": 2,
    "step": 1,
    "unit": "%"
   }
  ],
  "vars": [
   [
    "daily",
    "spent / max(1, day)"
   ],
   [
    "proj",
    "spent + daily * (30 - day) * (1 + growth/100 * (30 - day) / 2)"
   ],
   [
    "over",
    "proj > budget"
   ],
   [
    "pct",
    "spent / max(1, budget)"
   ]
  ],
  "nodes": [
   {
    "id": "s",
    "label": "Spend so far",
    "x": 0,
    "y": 0,
    "state": "pct>0.9 ? 2 : (pct>0.5 ? 1 : 0)",
    "sub": "round(pct*100) + ' percent of budget'"
   },
   {
    "id": "p",
    "label": "Projection",
    "x": 1,
    "y": 0,
    "state": "over ? 2 : 0",
    "sub": "round(proj) + ' USD at month end'"
   },
   {
    "id": "a",
    "label": "Alerts",
    "x": 2,
    "y": 0,
    "state": "pct>0.5 ? 1 : 0",
    "sub": "pct>0.9 ? '90 percent alert fired' : (pct>0.5 ? '50 percent alert fired' : 'none yet')"
   }
  ],
  "edges": [
   {
    "from": "s",
    "to": "p",
    "flow": "min(1, pct)",
    "bad": "over"
   },
   {
    "from": "p",
    "to": "a",
    "flow": "min(1, proj/max(1,budget)/1.5)",
    "bad": "over"
   }
  ],
  "readouts": [
   {
    "label": "Projected month end USD",
    "expr": "proj",
    "dp": 0
   },
   {
    "label": "Budget used percent",
    "expr": "pct * 100",
    "dp": 0
   },
   {
    "label": "Average per day USD",
    "expr": "daily",
    "dp": 0
   }
  ],
  "verdicts": [
   {
    "when": "over",
    "tone": "bad",
    "text": "At this pace the budget is exceeded before the month ends. Find the biggest cost driver by label, then fix or cap it."
   },
   {
    "when": "pct > 0.5",
    "tone": "warn",
    "text": "Half the budget is used; check the trend."
   },
   {
    "when": "true",
    "tone": "good",
    "text": "Spend is on track."
   }
  ],
  "tries": [
   "Raise growth to 20 percent.",
   "Cut the budget to 1000.",
   "Move to day 25 with the same spend."
  ],
  "presets": [
   {
    "id": "break",
    "label": "Break it",
    "story": "Spend grows faster than planned.",
    "tone": "bad",
    "values": {
     "budget": 5000,
     "spent": 3500,
     "day": 10,
     "growth": 8
    }
   },
   {
    "id": "fix",
    "label": "Fix it",
    "story": "Spend is steady and within budget.",
    "tone": "good",
    "values": {
     "budget": 8000,
     "spent": 1500,
     "day": 10,
     "growth": 0
    }
   }
  ]
 },
 {
  "id": "gcp-mig-capacity",
  "module": "gcp",
  "lesson": "gcp/compute-engine-images-and-managed-instance-groups",
  "title": "Autoscaler capacity and startup time",
  "summary": "A slow VM start lets a traffic spike pass unserved because new instances arrive too late.",
  "inputs": [
   {
    "id": "load",
    "label": "Load now",
    "min": 100,
    "max": 20000,
    "value": 2000,
    "step": 100,
    "unit": "req/s"
   },
   {
    "id": "per",
    "label": "Each VM handles",
    "min": 50,
    "max": 2000,
    "value": 300,
    "step": 10,
    "unit": "req/s"
   },
   {
    "id": "vms",
    "label": "VMs running",
    "min": 1,
    "max": 100,
    "value": 8,
    "step": 1
   },
   {
    "id": "start",
    "label": "VM start to ready",
    "min": 10,
    "max": 600,
    "value": 120,
    "step": 10,
    "unit": "s"
   }
  ],
  "vars": [
   [
    "cap",
    "vms * per"
   ],
   [
    "need",
    "ceil(load / per)"
   ],
   [
    "short",
    "load > cap"
   ],
   [
    "gap",
    "max(0, need - vms)"
   ]
  ],
  "nodes": [
   {
    "id": "l",
    "label": "Traffic",
    "x": 0,
    "y": 0,
    "state": "0",
    "sub": "round(load) + ' req/s'"
   },
   {
    "id": "g",
    "label": "Instance group",
    "x": 1,
    "y": 0,
    "state": "short ? 2 : (load>cap*0.8 ? 1 : 0)",
    "sub": "vms + ' VMs, ' + round(cap) + ' req/s'"
   },
   {
    "id": "a",
    "label": "Autoscaler",
    "x": 2,
    "y": 0,
    "state": "gap>0 ? 1 : 0",
    "sub": "gap + ' more needed, ready in ' + start + ' s'"
   }
  ],
  "edges": [
   {
    "from": "l",
    "to": "g",
    "flow": "min(1, load/20000 + 0.1)",
    "bad": "short"
   },
   {
    "from": "g",
    "to": "a",
    "flow": "min(1, gap/20)",
    "bad": "short"
   }
  ],
  "readouts": [
   {
    "label": "Capacity req per second",
    "expr": "cap",
    "dp": 0
   },
   {
    "label": "VMs needed",
    "expr": "need",
    "dp": 0
   },
   {
    "label": "Seconds until help arrives",
    "expr": "gap > 0 ? start : 0",
    "dp": 0
   }
  ],
  "verdicts": [
   {
    "when": "short && start > 90",
    "tone": "bad",
    "text": "Load is above capacity and new VMs take too long to appear, so users see errors during the ramp. Keep spare capacity or shorten the start time."
   },
   {
    "when": "short",
    "tone": "warn",
    "text": "Load exceeds capacity; the autoscaler will add VMs shortly."
   },
   {
    "when": "load > cap * 0.8",
    "tone": "warn",
    "text": "Close to capacity with little room for a spike."
   },
   {
    "when": "true",
    "tone": "good",
    "text": "Capacity covers the load with headroom."
   }
  ],
  "tries": [
   "Spike the load to 20000.",
   "Cut start time to 20 s.",
   "Raise the VM count."
  ],
  "presets": [
   {
    "id": "break",
    "label": "Break it",
    "story": "A spike arrives faster than new VMs.",
    "tone": "bad",
    "values": {
     "load": 6000,
     "per": 300,
     "vms": 8,
     "start": 300
    }
   },
   {
    "id": "fix",
    "label": "Fix it",
    "story": "Spare capacity covers the ramp.",
    "tone": "good",
    "values": {
     "load": 2000,
     "per": 300,
     "vms": 12,
     "start": 60
    }
   }
  ]
 },
 {
  "id": "gcp-cloudrun-scaling",
  "module": "gcp",
  "lesson": "gcp/cloud-run-and-cloud-functions",
  "title": "Cloud Run instances and limits",
  "summary": "Concurrency, latency and the maximum instance setting decide whether a surge is served or rejected.",
  "inputs": [
   {
    "id": "rps",
    "label": "Requests per second",
    "min": 1,
    "max": 5000,
    "value": 300,
    "step": 10
   },
   {
    "id": "lat",
    "label": "Request time",
    "min": 10,
    "max": 5000,
    "value": 200,
    "step": 10,
    "unit": "ms"
   },
   {
    "id": "conc",
    "label": "Concurrency per instance",
    "min": 1,
    "max": 250,
    "value": 40,
    "step": 1
   },
   {
    "id": "max",
    "label": "Max instances",
    "min": 1,
    "max": 200,
    "value": 10,
    "step": 1
   }
  ],
  "vars": [
   [
    "inflight",
    "rps * lat / 1000"
   ],
   [
    "need",
    "ceil(inflight / conc)"
   ],
   [
    "over",
    "need > max"
   ],
   [
    "use",
    "need / max"
   ]
  ],
  "nodes": [
   {
    "id": "c",
    "label": "Requests",
    "x": 0,
    "y": 0,
    "state": "0",
    "sub": "round(rps) + ' req/s'"
   },
   {
    "id": "i",
    "label": "Instances",
    "x": 1,
    "y": 0,
    "state": "over ? 2 : (use>0.8 ? 1 : 0)",
    "sub": "min(need, max) + ' of ' + max + ' used'"
   },
   {
    "id": "d",
    "label": "Dependencies",
    "x": 2,
    "y": 0,
    "state": "need>50 ? 1 : 0",
    "sub": "round(min(need,max)*conc) + ' connections possible'"
   }
  ],
  "edges": [
   {
    "from": "c",
    "to": "i",
    "flow": "min(1, rps/5000 + 0.1)",
    "bad": "over"
   },
   {
    "from": "i",
    "to": "d",
    "flow": "min(1, use)",
    "bad": "need>50"
   }
  ],
  "readouts": [
   {
    "label": "Instances needed",
    "expr": "need",
    "dp": 0
   },
   {
    "label": "Requests in flight",
    "expr": "inflight",
    "dp": 0
   },
   {
    "label": "Max instances",
    "expr": "max",
    "dp": 0
   }
  ],
  "verdicts": [
   {
    "when": "over",
    "tone": "bad",
    "text": "Demand needs more instances than the maximum, so requests queue and fail with 429 or 503. Raise the maximum or speed up the service."
   },
   {
    "when": "use > 0.8",
    "tone": "warn",
    "text": "Near the maximum; a small surge will hit the limit."
   },
   {
    "when": "need > 50",
    "tone": "warn",
    "text": "Many instances will open many database connections; check pool limits."
   },
   {
    "when": "true",
    "tone": "good",
    "text": "Plenty of headroom under the maximum."
   }
  ],
  "tries": [
   "Raise latency to 5000 ms.",
   "Set max instances to 3.",
   "Raise concurrency to 100."
  ],
  "presets": [
   {
    "id": "break",
    "label": "Break it",
    "story": "Slow requests need more instances than allowed.",
    "tone": "bad",
    "values": {
     "rps": 800,
     "lat": 2000,
     "conc": 20,
     "max": 10
    }
   },
   {
    "id": "fix",
    "label": "Fix it",
    "story": "Concurrency and limits fit the load.",
    "tone": "good",
    "values": {
     "rps": 300,
     "lat": 200,
     "conc": 80,
     "max": 20
    }
   }
  ]
 },
 {
  "id": "bigquery-scan-cost",
  "module": "gcp",
  "lesson": "gcp/cloud-sql-spanner-bigquery-and-firestore",
  "title": "BigQuery scan cost",
  "summary": "Partitioning and selecting fewer columns cut the bytes a query scans, and so its cost.",
  "inputs": [
   {
    "id": "size",
    "label": "Table size",
    "min": 10,
    "max": 200000,
    "value": 20000,
    "step": 100,
    "unit": "GB"
   },
   {
    "id": "part",
    "label": "Share of data the filter keeps",
    "min": 1,
    "max": 100,
    "value": 100,
    "step": 1,
    "unit": "%"
   },
   {
    "id": "cols",
    "label": "Columns read",
    "min": 1,
    "max": 100,
    "value": 40,
    "step": 1,
    "unit": "%"
   },
   {
    "id": "runs",
    "label": "Queries per day",
    "min": 1,
    "max": 500,
    "value": 40,
    "step": 1
   },
   {
    "id": "price",
    "label": "Price per TB scanned (check current)",
    "min": 1,
    "max": 20,
    "value": 6,
    "step": 1,
    "unit": "USD"
   }
  ],
  "vars": [
   [
    "scan",
    "size * part/100 * cols/100 / 1000"
   ],
   [
    "one",
    "scan * price"
   ],
   [
    "month",
    "one * runs * 30"
   ]
  ],
  "nodes": [
   {
    "id": "q",
    "label": "Query",
    "x": 0,
    "y": 0,
    "state": "part>80 ? 1 : 0",
    "sub": "part + ' percent of rows, ' + cols + ' percent of columns'"
   },
   {
    "id": "t",
    "label": "Table",
    "x": 1,
    "y": 0,
    "state": "scan>5 ? 2 : (scan>1 ? 1 : 0)",
    "sub": "round(scan*100)/100 + ' TB scanned'"
   },
   {
    "id": "b",
    "label": "Monthly bill",
    "x": 2,
    "y": 0,
    "state": "month>5000 ? 2 : (month>1000 ? 1 : 0)",
    "sub": "round(month) + ' USD'"
   }
  ],
  "edges": [
   {
    "from": "q",
    "to": "t",
    "flow": "min(1, scan/10 + 0.1)",
    "bad": "scan>5"
   },
   {
    "from": "t",
    "to": "b",
    "flow": "min(1, month/10000)",
    "bad": "month>5000"
   }
  ],
  "readouts": [
   {
    "label": "Scanned per query TB",
    "expr": "scan",
    "dp": 2
   },
   {
    "label": "Cost per query USD",
    "expr": "one",
    "dp": 2
   },
   {
    "label": "Cost per month USD",
    "expr": "month",
    "dp": 0
   }
  ],
  "verdicts": [
   {
    "when": "month > 5000",
    "tone": "bad",
    "text": "Queries scan far too much data. Partition by date, cluster by filter columns, select only the columns needed, and always dry-run first."
   },
   {
    "when": "month > 1000",
    "tone": "warn",
    "text": "The bill is noticeable; look for a missing partition filter."
   },
   {
    "when": "true",
    "tone": "good",
    "text": "Scans are small and cheap."
   }
  ],
  "tries": [
   "Read 100 percent of columns and rows.",
   "Filter to 1 percent of rows.",
   "Run 500 queries per day."
  ],
  "presets": [
   {
    "id": "break",
    "label": "Break it",
    "story": "Full-table scans run all day.",
    "tone": "bad",
    "values": {
     "size": 100000,
     "part": 100,
     "cols": 100,
     "runs": 200,
     "price": 6
    }
   },
   {
    "id": "fix",
    "label": "Fix it",
    "story": "Partitioned tables and narrow selects.",
    "tone": "good",
    "values": {
     "size": 100000,
     "part": 2,
     "cols": 10,
     "runs": 200,
     "price": 6
    }
   }
  ]
 }
]
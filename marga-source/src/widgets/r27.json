[
 {
  "id": "psi-drift",
  "module": "mlops",
  "lesson": "mlops/monitoring-drift-and-retraining",
  "title": "Drift score for one feature",
  "summary": "Compare the share of one group in training and in production, and see the population stability index. Above 0.25 is usually a real shift.",
  "inputs": [
   {
    "id": "t",
    "label": "Share of mobile users in training",
    "min": 5,
    "max": 95,
    "value": 40,
    "step": 1,
    "unit": "%"
   },
   {
    "id": "l",
    "label": "Share of mobile users in production now",
    "min": 5,
    "max": 95,
    "value": 40,
    "step": 1,
    "unit": "%"
   }
  ],
  "vars": [
   [
    "a",
    "t/100"
   ],
   [
    "b",
    "l/100"
   ],
   [
    "psi",
    "(b-a)*log(b/a)+((1-b)-(1-a))*log((1-b)/(1-a))"
   ]
  ],
  "nodes": [
   {
    "id": "tr",
    "label": "Training data",
    "x": 0,
    "y": 0,
    "state": "0",
    "sub": "pct(a,0)+\" mobile\""
   },
   {
    "id": "mon",
    "label": "Drift check",
    "x": 1,
    "y": 0,
    "state": "psi>0.25?2:(psi>0.1?1:0)",
    "sub": "\"PSI \"+psi"
   },
   {
    "id": "pr",
    "label": "Production data",
    "x": 2,
    "y": 0,
    "state": "0",
    "sub": "pct(b,0)+\" mobile\""
   }
  ],
  "edges": [
   {
    "from": "tr",
    "to": "mon",
    "flow": "0.8",
    "bad": "false"
   },
   {
    "from": "pr",
    "to": "mon",
    "flow": "0.8",
    "bad": "false"
   }
  ],
  "readouts": [
   {
    "label": "Population stability index",
    "expr": "psi",
    "dp": 3
   },
   {
    "label": "Change in share",
    "expr": "(b-a)*100",
    "dp": 1,
    "unit": "points"
   }
  ],
  "verdicts": [
   {
    "when": "psi>0.25",
    "tone": "bad",
    "text": "A shift this large usually means the model sees a different population. Check upstream data and quality on this segment."
   },
   {
    "when": "psi>0.1",
    "tone": "warn",
    "text": "A moderate shift. Watch it over a longer window before acting."
   },
   {
    "when": "true",
    "tone": "good",
    "text": "Production looks like training for this feature."
   }
  ],
  "tries": [
   "Set production to 55 percent and read the score.",
   "Try 41 percent. Small changes score very low.",
   "Move training to 10 percent and production to 30 percent."
  ],
  "presets": [
   {
    "id": "break",
    "label": "Break it",
    "story": "A new app release brings many more mobile users.",
    "tone": "bad",
    "values": {
     "t": 40,
     "l": 65
    }
   },
   {
    "id": "fix",
    "label": "Fix it",
    "story": "Back to the usual mix.",
    "tone": "good",
    "values": {
     "t": 40,
     "l": 41
    }
   }
  ]
 },
 {
  "id": "canary-size",
  "module": "mlops",
  "lesson": "mlops/model-registry-packaging-and-safe-releases",
  "title": "How long a canary must run",
  "summary": "See how many requests and how many hours a canary needs before a small quality drop can be told apart from noise.",
  "inputs": [
   {
    "id": "p",
    "label": "Current error rate",
    "min": 1,
    "max": 30,
    "value": 8,
    "step": 0.5,
    "unit": "%"
   },
   {
    "id": "d",
    "label": "Smallest increase you must catch",
    "min": 0.5,
    "max": 5,
    "value": 2,
    "step": 0.5,
    "unit": "points"
   },
   {
    "id": "share",
    "label": "Share of traffic to the canary",
    "min": 1,
    "max": 50,
    "value": 5,
    "step": 1,
    "unit": "%"
   },
   {
    "id": "rps",
    "label": "Total requests per second",
    "min": 1,
    "max": 500,
    "value": 40,
    "step": 1
   }
  ],
  "vars": [
   [
    "pp",
    "p/100"
   ],
   [
    "dd",
    "d/100"
   ],
   [
    "n",
    "16*pp*(1-pp)/(dd*dd)"
   ],
   [
    "cr",
    "rps*share/100"
   ],
   [
    "hours",
    "n/cr/3600"
   ]
  ],
  "nodes": [
   {
    "id": "all",
    "label": "All traffic",
    "x": 0,
    "y": 0,
    "state": "0",
    "sub": "rps+\" req/s\""
   },
   {
    "id": "can",
    "label": "Canary",
    "x": 1,
    "y": 0,
    "state": "hours>24?2:(hours>6?1:0)",
    "sub": "round(n)+\" requests needed\""
   },
   {
    "id": "dec",
    "label": "Decision",
    "x": 2,
    "y": 0,
    "state": "hours>24?2:(hours>6?1:0)",
    "sub": "round(hours*10)/10+\" hours\""
   }
  ],
  "edges": [
   {
    "from": "all",
    "to": "can",
    "flow": "share/50",
    "bad": "false"
   },
   {
    "from": "can",
    "to": "dec",
    "flow": "0.7",
    "bad": "hours>24"
   }
  ],
  "readouts": [
   {
    "label": "Requests needed in the canary",
    "expr": "n",
    "dp": 0
   },
   {
    "label": "Hours to a reliable answer",
    "expr": "hours",
    "dp": 1,
    "unit": "hours"
   }
  ],
  "verdicts": [
   {
    "when": "hours>24",
    "tone": "bad",
    "text": "A day or more. Raise the canary share, use a faster signal, or accept only a coarser check."
   },
   {
    "when": "hours>6",
    "tone": "warn",
    "text": "Workable, but the canary has to run through an extended period."
   },
   {
    "when": "true",
    "tone": "good",
    "text": "Enough traffic to decide within a working session."
   }
  ],
  "tries": [
   "Cut the canary share to 1 percent.",
   "Ask to catch a 0.5 point change.",
   "Raise traffic to 300 requests per second."
  ],
  "presets": [
   {
    "id": "break",
    "label": "Break it",
    "story": "A 1 percent canary on a modest service.",
    "tone": "bad",
    "values": {
     "p": 8,
     "d": 1,
     "share": 1,
     "rps": 20
    }
   },
   {
    "id": "fix",
    "label": "Fix it",
    "story": "A bigger share and a coarser threshold.",
    "tone": "good",
    "values": {
     "p": 8,
     "d": 3,
     "share": 20,
     "rps": 100
    }
   }
  ]
 },
 {
  "id": "batch-latency",
  "module": "mlops",
  "lesson": "mlops/serving-models-batch-online-and-streaming",
  "title": "Dynamic batching and latency",
  "summary": "Waiting a little to group requests raises throughput. See the latency price and the number of replicas you need.",
  "inputs": [
   {
    "id": "rps",
    "label": "Requests per second",
    "min": 5,
    "max": 1000,
    "value": 200,
    "step": 5
   },
   {
    "id": "maxb",
    "label": "Largest batch",
    "min": 1,
    "max": 64,
    "value": 16,
    "step": 1
   },
   {
    "id": "wait",
    "label": "Longest wait to fill a batch",
    "min": 1,
    "max": 100,
    "value": 10,
    "step": 1,
    "unit": "ms"
   },
   {
    "id": "item",
    "label": "Time per item in a batch",
    "min": 1,
    "max": 40,
    "value": 3,
    "step": 1,
    "unit": "ms"
   },
   {
    "id": "over",
    "label": "Fixed cost per batch",
    "min": 1,
    "max": 60,
    "value": 12,
    "step": 1,
    "unit": "ms"
   }
  ],
  "vars": [
   [
    "b",
    "max(1,min(maxb,rps*wait/1000))"
   ],
   [
    "svc",
    "over+item*b"
   ],
   [
    "lat",
    "wait+svc"
   ],
   [
    "thr",
    "b/svc*1000"
   ],
   [
    "rep",
    "ceil(rps/thr)"
   ]
  ],
  "nodes": [
   {
    "id": "c",
    "label": "Requests",
    "x": 0,
    "y": 0,
    "state": "0",
    "sub": "rps+\" req/s\""
   },
   {
    "id": "bt",
    "label": "Batcher",
    "x": 1,
    "y": 0,
    "state": "lat>100?2:(lat>60?1:0)",
    "sub": "\"batch of \"+round(b)"
   },
   {
    "id": "m",
    "label": "Model replicas",
    "x": 2,
    "y": 0,
    "state": "rep>8?1:0",
    "sub": "rep+\" replicas\""
   }
  ],
  "edges": [
   {
    "from": "c",
    "to": "bt",
    "flow": "0.8",
    "bad": "false"
   },
   {
    "from": "bt",
    "to": "m",
    "flow": "0.8",
    "bad": "lat>100"
   }
  ],
  "readouts": [
   {
    "label": "Typical latency",
    "expr": "lat",
    "dp": 0,
    "unit": "ms"
   },
   {
    "label": "Replicas needed",
    "expr": "rep",
    "dp": 0
   },
   {
    "label": "Average batch size",
    "expr": "b",
    "dp": 1
   }
  ],
  "verdicts": [
   {
    "when": "lat>100",
    "tone": "bad",
    "text": "Latency is past a typical budget. Cut the wait or the batch size."
   },
   {
    "when": "lat>60",
    "tone": "warn",
    "text": "Getting slow for an interactive call. Check it against your budget."
   },
   {
    "when": "true",
    "tone": "good",
    "text": "Latency is modest and throughput is good."
   }
  ],
  "tries": [
   "Set the wait to 1 ms and watch replicas rise.",
   "Set the wait to 80 ms and watch latency.",
   "Cut the fixed cost per batch."
  ],
  "presets": [
   {
    "id": "break",
    "label": "Break it",
    "story": "A long wait and large batches.",
    "tone": "bad",
    "values": {
     "rps": 200,
     "maxb": 64,
     "wait": 90,
     "item": 3,
     "over": 12
    }
   },
   {
    "id": "fix",
    "label": "Fix it",
    "story": "A short wait with moderate batches.",
    "tone": "good",
    "values": {
     "rps": 200,
     "maxb": 16,
     "wait": 8,
     "item": 3,
     "over": 12
    }
   }
  ]
 },
 {
  "id": "retrain-cadence",
  "module": "mlops",
  "lesson": "mlops/monitoring-drift-and-retraining",
  "title": "How often to retrain",
  "summary": "Balance the cost of a retrain against the value lost as a model ages. The best interval is where the two meet.",
  "inputs": [
   {
    "id": "d",
    "label": "Quality lost each week",
    "min": 0.1,
    "max": 3,
    "value": 0.5,
    "step": 0.1,
    "unit": "points"
   },
   {
    "id": "v",
    "label": "Value of one quality point per week",
    "min": 100,
    "max": 20000,
    "value": 2000,
    "step": 100,
    "unit": "$"
   },
   {
    "id": "c",
    "label": "Cost of one retrain",
    "min": 50,
    "max": 20000,
    "value": 1500,
    "step": 50,
    "unit": "$"
   },
   {
    "id": "n",
    "label": "Weeks between retrains",
    "min": 1,
    "max": 26,
    "value": 8,
    "step": 1
   }
  ],
  "vars": [
   [
    "loss",
    "v*d*n/2"
   ],
   [
    "cost",
    "loss+c/n"
   ],
   [
    "opt",
    "sqrt(2*c/(v*d))"
   ],
   [
    "bestcost",
    "v*d*opt/2+c/opt"
   ]
  ],
  "nodes": [
   {
    "id": "m",
    "label": "Model ageing",
    "x": 0,
    "y": 0,
    "state": "d>1.5?1:0",
    "sub": "d+\" points a week\""
   },
   {
    "id": "r",
    "label": "Retrain every",
    "x": 1,
    "y": 0,
    "state": "n>2*opt||n<opt/2?1:0",
    "sub": "n+\" weeks\""
   },
   {
    "id": "t",
    "label": "Weekly cost",
    "x": 2,
    "y": 0,
    "state": "cost>1.5*bestcost?2:(cost>1.15*bestcost?1:0)",
    "sub": "\"$\"+round(cost)"
   }
  ],
  "edges": [
   {
    "from": "m",
    "to": "r",
    "flow": "0.7",
    "bad": "false"
   },
   {
    "from": "r",
    "to": "t",
    "flow": "0.7",
    "bad": "cost>1.5*bestcost"
   }
  ],
  "readouts": [
   {
    "label": "Weekly cost at this interval",
    "expr": "cost",
    "dp": 0,
    "unit": "$"
   },
   {
    "label": "Best interval",
    "expr": "opt",
    "dp": 1,
    "unit": "weeks"
   },
   {
    "label": "Weekly cost at the best interval",
    "expr": "bestcost",
    "dp": 0,
    "unit": "$"
   }
  ],
  "verdicts": [
   {
    "when": "cost>1.5*bestcost",
    "tone": "bad",
    "text": "Far from the best interval. Either you retrain too often or models age too long."
   },
   {
    "when": "cost>1.15*bestcost",
    "tone": "warn",
    "text": "A little off the best interval. Close enough to tune later."
   },
   {
    "when": "true",
    "tone": "good",
    "text": "Near the lowest total cost."
   }
  ],
  "tries": [
   "Retrain every week and watch the cost.",
   "Retrain every 26 weeks.",
   "Make retraining cheap and see the best interval shorten."
  ],
  "presets": [
   {
    "id": "break",
    "label": "Break it",
    "story": "Retraining far too rarely.",
    "tone": "bad",
    "values": {
     "d": 1.5,
     "v": 3000,
     "c": 800,
     "n": 26
    }
   },
   {
    "id": "fix",
    "label": "Fix it",
    "story": "Retraining near the best point.",
    "tone": "good",
    "values": {
     "d": 1.5,
     "v": 3000,
     "c": 800,
     "n": 4
    }
   }
  ]
 },
 {
  "id": "alert-load",
  "module": "aiops",
  "lesson": "aiops/what-aiops-is-and-is-not",
  "title": "Alert noise and on-call cost",
  "summary": "Turn alert volume into hours of lost attention, and see what happens when more alerts need no action.",
  "inputs": [
   {
    "id": "a",
    "label": "Alerts a day",
    "min": 10,
    "max": 2000,
    "value": 300,
    "step": 10
   },
   {
    "id": "act",
    "label": "Share that need action",
    "min": 2,
    "max": 100,
    "value": 25,
    "step": 1,
    "unit": "%"
   },
   {
    "id": "m",
    "label": "Minutes to triage one alert",
    "min": 1,
    "max": 15,
    "value": 4,
    "step": 1,
    "unit": "min"
   },
   {
    "id": "e",
    "label": "Engineers sharing the pager",
    "min": 1,
    "max": 12,
    "value": 4,
    "step": 1
   }
  ],
  "vars": [
   [
    "wasted",
    "a*(1-act/100)*m/60"
   ],
   [
    "per",
    "wasted/e"
   ],
   [
    "useful",
    "a*act/100*m/60"
   ]
  ],
  "nodes": [
   {
    "id": "al",
    "label": "Alerts",
    "x": 0,
    "y": 0,
    "state": "a>500?1:0",
    "sub": "a+\" a day\""
   },
   {
    "id": "tri",
    "label": "Triage",
    "x": 1,
    "y": 0,
    "state": "per>3?2:(per>1.5?1:0)",
    "sub": "round(wasted*10)/10+\" hours wasted\""
   },
   {
    "id": "oc",
    "label": "On-call",
    "x": 2,
    "y": 0,
    "state": "per>3?2:(per>1.5?1:0)",
    "sub": "round(per*10)/10+\" hours each\""
   }
  ],
  "edges": [
   {
    "from": "al",
    "to": "tri",
    "flow": "0.8",
    "bad": "false"
   },
   {
    "from": "tri",
    "to": "oc",
    "flow": "0.7",
    "bad": "per>3"
   }
  ],
  "readouts": [
   {
    "label": "Hours a day on alerts that need no action",
    "expr": "wasted",
    "dp": 1,
    "unit": "hours"
   },
   {
    "label": "Per engineer",
    "expr": "per",
    "dp": 1,
    "unit": "hours"
   },
   {
    "label": "Hours on useful alerts",
    "expr": "useful",
    "dp": 1,
    "unit": "hours"
   }
  ],
  "verdicts": [
   {
    "when": "per>3",
    "tone": "bad",
    "text": "Several hours of each engineer's day vanish into noise. Fix the alerts before adding more tools."
   },
   {
    "when": "per>1.5",
    "tone": "warn",
    "text": "Noise is taking a meaningful share of attention."
   },
   {
    "when": "true",
    "tone": "good",
    "text": "Most alert time goes to real problems."
   }
  ],
  "tries": [
   "Raise alerts to 1500 with 10 percent actionable.",
   "Raise the actionable share to 80 percent.",
   "Add engineers and see why that is not a fix."
  ],
  "presets": [
   {
    "id": "break",
    "label": "Break it",
    "story": "Many alerts, few useful.",
    "tone": "bad",
    "values": {
     "a": 1200,
     "act": 10,
     "m": 5,
     "e": 4
    }
   },
   {
    "id": "fix",
    "label": "Fix it",
    "story": "Fewer, better alerts.",
    "tone": "good",
    "values": {
     "a": 150,
     "act": 70,
     "m": 5,
     "e": 4
    }
   }
  ]
 },
 {
  "id": "zscore-alarms",
  "module": "aiops",
  "lesson": "aiops/anomaly-detection-on-metrics",
  "title": "Threshold, duration and false alarms",
  "summary": "See how a stricter threshold and a required duration cut false alarms for a metric that is behaving normally.",
  "inputs": [
   {
    "id": "z",
    "label": "Alert at this many standard deviations",
    "min": 1,
    "max": 5,
    "value": 3,
    "step": 0.1
   },
   {
    "id": "k",
    "label": "Samples in a row required",
    "min": 1,
    "max": 10,
    "value": 1,
    "step": 1
   },
   {
    "id": "s",
    "label": "Samples a day",
    "min": 100,
    "max": 5000,
    "value": 1440,
    "step": 10
   }
  ],
  "vars": [
   [
    "p",
    "2*0.5*exp(-0.717*z-0.416*z*z)"
   ],
   [
    "fa",
    "s*pow(p,k)"
   ],
   [
    "month",
    "fa*30"
   ]
  ],
  "nodes": [
   {
    "id": "m",
    "label": "Normal metric",
    "x": 0,
    "y": 0,
    "state": "0",
    "sub": "s+\" samples a day\""
   },
   {
    "id": "r",
    "label": "Rule",
    "x": 1,
    "y": 0,
    "state": "fa>5?2:(fa>0.5?1:0)",
    "sub": "z+\" sd, \"+k+\" in a row\""
   },
   {
    "id": "a",
    "label": "False alarms",
    "x": 2,
    "y": 0,
    "state": "fa>5?2:(fa>0.5?1:0)",
    "sub": "round(fa*100)/100+\" a day\""
   }
  ],
  "edges": [
   {
    "from": "m",
    "to": "r",
    "flow": "0.8",
    "bad": "false"
   },
   {
    "from": "r",
    "to": "a",
    "flow": "min(1,fa/10)",
    "bad": "fa>5"
   }
  ],
  "readouts": [
   {
    "label": "False alarms a day",
    "expr": "fa",
    "dp": 2
   },
   {
    "label": "False alarms a month",
    "expr": "month",
    "dp": 1
   },
   {
    "label": "Chance a normal sample trips it",
    "expr": "p*100",
    "dp": 2,
    "unit": "%"
   }
  ],
  "verdicts": [
   {
    "when": "fa>5",
    "tone": "bad",
    "text": "Constant false alarms. People will mute this rule. Raise the threshold or require more samples in a row."
   },
   {
    "when": "fa>0.5",
    "tone": "warn",
    "text": "Still more than one false alarm every other day."
   },
   {
    "when": "true",
    "tone": "good",
    "text": "Quiet on a healthy metric. Check it still catches a real fault."
   }
  ],
  "tries": [
   "Set the threshold to 2 and one sample.",
   "Require 3 in a row at 2.5.",
   "Go to 4 standard deviations and check it still catches faults."
  ],
  "presets": [
   {
    "id": "break",
    "label": "Break it",
    "story": "A touchy rule that fires on every blip.",
    "tone": "bad",
    "values": {
     "z": 2,
     "k": 1,
     "s": 1440
    }
   },
   {
    "id": "fix",
    "label": "Fix it",
    "story": "Stricter, and it must persist.",
    "tone": "good",
    "values": {
     "z": 3,
     "k": 3,
     "s": 1440
    }
   }
  ]
 },
 {
  "id": "storm-grouping",
  "module": "aiops",
  "lesson": "aiops/alert-correlation-and-noise-reduction",
  "title": "One fault, how many pages",
  "summary": "Many services fail because of one shared dependency. See what reaches the pager with and without grouping and inhibition.",
  "inputs": [
   {
    "id": "n",
    "label": "Services affected",
    "min": 1,
    "max": 60,
    "value": 29,
    "step": 1
   },
   {
    "id": "a",
    "label": "Alerts per service",
    "min": 1,
    "max": 10,
    "value": 6,
    "step": 1
   },
   {
    "id": "group",
    "label": "Group by dependency",
    "type": "toggle",
    "value": false
   },
   {
    "id": "inh",
    "label": "Inhibit downstream alerts",
    "type": "toggle",
    "value": false
   }
  ],
  "vars": [
   [
    "raw",
    "n*a"
   ],
   [
    "shown",
    "group?(inh?1:n):raw"
   ],
   [
    "mins",
    "shown*0.5"
   ]
  ],
  "nodes": [
   {
    "id": "f",
    "label": "Shared fault",
    "x": 0,
    "y": 0,
    "state": "0",
    "sub": "n+\" services affected\""
   },
   {
    "id": "c",
    "label": "Correlator",
    "x": 1,
    "y": 0,
    "state": "group?0:1",
    "sub": "group?\"grouping on\":\"no grouping\""
   },
   {
    "id": "p",
    "label": "Pager",
    "x": 2,
    "y": 0,
    "state": "shown>20?2:(shown>3?1:0)",
    "sub": "shown+\" items\""
   }
  ],
  "edges": [
   {
    "from": "f",
    "to": "c",
    "flow": "0.8",
    "bad": "false"
   },
   {
    "from": "c",
    "to": "p",
    "flow": "min(1,shown/40)",
    "bad": "shown>20"
   }
  ],
  "readouts": [
   {
    "label": "Alerts generated",
    "expr": "raw",
    "dp": 0
   },
   {
    "label": "Items on the pager",
    "expr": "shown",
    "dp": 0
   },
   {
    "label": "Minutes just to read them",
    "expr": "mins",
    "dp": 1,
    "unit": "min"
   }
  ],
  "verdicts": [
   {
    "when": "shown>20",
    "tone": "bad",
    "text": "A wall of alerts. The cause is buried among its echoes."
   },
   {
    "when": "shown>3",
    "tone": "warn",
    "text": "Better, but the dependents still compete with the cause."
   },
   {
    "when": "true",
    "tone": "good",
    "text": "One incident with the cause on top and the echoes folded under it."
   }
  ],
  "tries": [
   "Turn on grouping only.",
   "Turn on both grouping and inhibition.",
   "Set services to 60 and compare."
  ],
  "presets": [
   {
    "id": "break",
    "label": "Break it",
    "story": "Every alert reaches the pager.",
    "tone": "bad",
    "values": {
     "n": 29,
     "a": 6,
     "group": false,
     "inh": false
    }
   },
   {
    "id": "fix",
    "label": "Fix it",
    "story": "Grouped and inhibited.",
    "tone": "good",
    "values": {
     "n": 29,
     "a": 6,
     "group": true,
     "inh": true
    }
   }
  ]
 },
 {
  "id": "remediation-limits",
  "module": "aiops",
  "lesson": "aiops/safe-automation-and-auto-remediation",
  "title": "How far one automation can reach",
  "summary": "See how limits on rate, cooldown and share of the fleet cap what a wrong automation rule can touch.",
  "inputs": [
   {
    "id": "rate",
    "label": "Times the rule triggers an hour",
    "min": 1,
    "max": 60,
    "value": 30,
    "step": 1
   },
   {
    "id": "maxh",
    "label": "Maximum actions an hour",
    "min": 1,
    "max": 60,
    "value": 60,
    "step": 1
   },
   {
    "id": "cd",
    "label": "Cooldown between actions",
    "min": 1,
    "max": 60,
    "value": 1,
    "step": 1,
    "unit": "min"
   },
   {
    "id": "share",
    "label": "Share of the fleet each action touches",
    "min": 1,
    "max": 100,
    "value": 50,
    "step": 1,
    "unit": "%"
   }
  ],
  "vars": [
   [
    "byc",
    "60/cd"
   ],
   [
    "acts",
    "min(rate,min(maxh,byc))"
   ],
   [
    "reach",
    "min(100,acts*share)"
   ]
  ],
  "nodes": [
   {
    "id": "t",
    "label": "Trigger",
    "x": 0,
    "y": 0,
    "state": "rate>20?1:0",
    "sub": "rate+\" an hour\""
   },
   {
    "id": "l",
    "label": "Limits",
    "x": 1,
    "y": 0,
    "state": "reach>50?2:(reach>20?1:0)",
    "sub": "round(acts)+\" actions an hour\""
   },
   {
    "id": "f",
    "label": "Fleet touched",
    "x": 2,
    "y": 0,
    "state": "reach>50?2:(reach>20?1:0)",
    "sub": "round(reach)+\" percent in an hour\""
   }
  ],
  "edges": [
   {
    "from": "t",
    "to": "l",
    "flow": "0.8",
    "bad": "false"
   },
   {
    "from": "l",
    "to": "f",
    "flow": "min(1,reach/100)",
    "bad": "reach>50"
   }
  ],
  "readouts": [
   {
    "label": "Actions in an hour",
    "expr": "acts",
    "dp": 0
   },
   {
    "label": "Fleet reached in an hour",
    "expr": "reach",
    "dp": 0,
    "unit": "%"
   }
  ],
  "verdicts": [
   {
    "when": "reach>50",
    "tone": "bad",
    "text": "A wrong rule could touch most of the fleet in an hour. Add limits before trusting it."
   },
   {
    "when": "reach>20",
    "tone": "warn",
    "text": "Still a large reach. Narrow the share each action touches."
   },
   {
    "when": "true",
    "tone": "good",
    "text": "Contained. A mistake would be visible and stoppable."
   }
  ],
  "tries": [
   "Set maximum actions to 2 and the cooldown to 30 minutes.",
   "Cut the share per action to 5 percent.",
   "Compare no limits with all limits."
  ],
  "presets": [
   {
    "id": "break",
    "label": "Break it",
    "story": "No real limits.",
    "tone": "bad",
    "values": {
     "rate": 30,
     "maxh": 60,
     "cd": 1,
     "share": 50
    }
   },
   {
    "id": "fix",
    "label": "Fix it",
    "story": "Rate limit, cooldown and a small blast radius.",
    "tone": "good",
    "values": {
     "rate": 30,
     "maxh": 2,
     "cd": 30,
     "share": 5
    }
   }
  ]
 }
]
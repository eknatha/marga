[
 {
  "id": "sc2-chain",
  "module": "k8s-supply-chain",
  "lesson": "k8s-supply-chain/the-software-supply-chain-threat-model-and-slsa",
  "title": "How protected is the chain?",
  "summary": "Toggle the controls along the path from source to runtime.",
  "inputs": [
   {
    "id": "a",
    "label": "Branch protection and review",
    "type": "toggle",
    "value": false
   },
   {
    "id": "b",
    "label": "Hosted builder with provenance",
    "type": "toggle",
    "value": false
   },
   {
    "id": "c",
    "label": "Signed immutable images",
    "type": "toggle",
    "value": false
   },
   {
    "id": "d",
    "label": "Signature checked at admission",
    "type": "toggle",
    "value": false
   }
  ],
  "vars": [
   [
    "done",
    "(a?1:0)+(b?1:0)+(c?1:0)+(d?1:0)"
   ]
  ],
  "nodes": [
   {
    "id": "n0",
    "label": "Source",
    "x": 0,
    "y": 0,
    "state": "a ? 0 : 2",
    "sub": "a ? 'protected' : 'open'"
   },
   {
    "id": "n1",
    "label": "Build",
    "x": 1,
    "y": 0,
    "state": "b ? 0 : 2",
    "sub": "b ? 'provenance' : 'none'"
   },
   {
    "id": "n2",
    "label": "Registry",
    "x": 2,
    "y": 0,
    "state": "c ? 0 : 2",
    "sub": "c ? 'signed' : 'mutable'"
   }
  ],
  "edges": [
   {
    "from": "n0",
    "to": "n1",
    "flow": "a?0:1",
    "bad": "!a"
   },
   {
    "from": "n1",
    "to": "n2",
    "flow": "b?0:1",
    "bad": "!b"
   }
  ],
  "readouts": [
   {
    "label": "Practices in place",
    "expr": "done",
    "dp": 0
   },
   {
    "label": "Practices missing",
    "expr": "4-done",
    "dp": 0
   },
   {
    "label": "Total practices",
    "expr": "4",
    "dp": 0
   }
  ],
  "verdicts": [
   {
    "when": "!a",
    "tone": "bad",
    "text": "Without source protection anyone can push a change that flows to production."
   },
   {
    "when": "!b || !c || !d",
    "tone": "warn",
    "text": "Source is protected but a later stage lets tampering through."
   },
   {
    "when": "true",
    "tone": "good",
    "text": "Every stage has a control and the cluster verifies it."
   }
  ],
  "tries": [
   "Turn on only \"Branch protection and review\".",
   "Turn on all four.",
   "Turn on everything except \"Signature checked at admission\"."
  ],
  "presets": [
   {
    "id": "break",
    "label": "Break it",
    "story": "Nothing in place.",
    "tone": "bad",
    "values": {
     "a": false,
     "b": false,
     "c": false,
     "d": false
    }
   },
   {
    "id": "fix",
    "label": "Fix it",
    "story": "All practices in place.",
    "tone": "good",
    "values": {
     "a": true,
     "b": true,
     "c": true,
     "d": true
    }
   }
  ]
 },
 {
  "id": "sc2-scan",
  "module": "k8s-supply-chain",
  "lesson": "k8s-supply-chain/image-scanning-and-vulnerability-management",
  "title": "Does scanning lead to fixes?",
  "summary": "Check whether scanning produces action, not only reports.",
  "inputs": [
   {
    "id": "a",
    "label": "Scan in CI",
    "type": "toggle",
    "value": false
   },
   {
    "id": "b",
    "label": "Rescan stored images",
    "type": "toggle",
    "value": false
   },
   {
    "id": "c",
    "label": "Owner and deadline per finding",
    "type": "toggle",
    "value": false
   },
   {
    "id": "d",
    "label": "Rebuild on patched base",
    "type": "toggle",
    "value": false
   }
  ],
  "vars": [
   [
    "done",
    "(a?1:0)+(b?1:0)+(c?1:0)+(d?1:0)"
   ]
  ],
  "nodes": [
   {
    "id": "n0",
    "label": "CI",
    "x": 0,
    "y": 0,
    "state": "a ? 0 : 2",
    "sub": "a ? 'scanned' : 'unscanned'"
   },
   {
    "id": "n1",
    "label": "Registry",
    "x": 1,
    "y": 0,
    "state": "b ? 0 : 2",
    "sub": "b ? 'rescanned' : 'stale'"
   },
   {
    "id": "n2",
    "label": "Owners",
    "x": 2,
    "y": 0,
    "state": "c ? 0 : 2",
    "sub": "c ? 'owned' : 'ignored'"
   }
  ],
  "edges": [
   {
    "from": "n0",
    "to": "n1",
    "flow": "a?0:1",
    "bad": "!a"
   },
   {
    "from": "n1",
    "to": "n2",
    "flow": "b?0:1",
    "bad": "!b"
   }
  ],
  "readouts": [
   {
    "label": "Practices in place",
    "expr": "done",
    "dp": 0
   },
   {
    "label": "Practices missing",
    "expr": "4-done",
    "dp": 0
   },
   {
    "label": "Total practices",
    "expr": "4",
    "dp": 0
   }
  ],
  "verdicts": [
   {
    "when": "!a",
    "tone": "bad",
    "text": "Images are never scanned, so known flaws ship unnoticed."
   },
   {
    "when": "!b || !c || !d",
    "tone": "warn",
    "text": "Scanning exists but findings are not turned into rebuilds."
   },
   {
    "when": "true",
    "tone": "good",
    "text": "Findings are scanned, owned and fixed by rebuilding."
   }
  ],
  "tries": [
   "Turn on only \"Scan in CI\".",
   "Turn on all four.",
   "Turn on everything except \"Rebuild on patched base\"."
  ],
  "presets": [
   {
    "id": "break",
    "label": "Break it",
    "story": "Nothing in place.",
    "tone": "bad",
    "values": {
     "a": false,
     "b": false,
     "c": false,
     "d": false
    }
   },
   {
    "id": "fix",
    "label": "Fix it",
    "story": "All practices in place.",
    "tone": "good",
    "values": {
     "a": true,
     "b": true,
     "c": true,
     "d": true
    }
   }
  ]
 },
 {
